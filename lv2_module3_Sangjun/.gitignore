# ============================================
# ROS 2 / Colcon Build Artifacts
# ============================================

**/ros2_ws/build/
**/ros2_ws/install/
**/ros2_ws/log/
**/.ros/


# ============================================
# Firmware Build Artifacts
# ============================================

**/firmware/build/
*.o
*.elf

# Firmware .bin files may be committed intentionally.


# ============================================
# Python
# ============================================

__pycache__/
*.py[cod]
*$py.class

.pytest_cache/
.mypy_cache/
.ruff_cache/

*.egg-info/
.eggs/


# ============================================
# Virtual Environments
# ============================================

.venv/
venv/
env/
ENV/


# ============================================
# IDE / Editor
# ============================================

.vscode/
.idea/

*.swp
*.swo
*~


# ============================================
# OS Generated Files
# ============================================

.DS_Store
Thumbs.db


# ============================================
# Temporary Files
# ============================================

*.tmp
*.temp
*.bak
*.backup


# ============================================
# ROS Bags / Recordings
# Store separately and document download links
# in lv2_module5/recordings/README.md.
# ============================================

*.bag
*.db3
*.db3-shm
*.db3-wal
*.mcap

**/rosbag2_*/


# ============================================
# Large Video Files
# ============================================

*.mp4
*.avi
*.mov
*.mkv
*.webm


# ============================================
# Local Secrets / Personal Files
# ============================================

.env
.env.*
!.env.example

*.local
*_private.md
*_personal.md


# ============================================
# Assignment Evidence — Keep in Git
# ============================================

# Do not globally ignore:
# - *.log
# - *.csv
# - *.png, *.jpg, *.jpeg
# - results/images/
# - results/plots/
# - results/logs/
#
# Git tracks files, not empty directories.
# Use .gitkeep where an empty directory is needed.