--- Miniterm on /dev/serial/by-id/usb-ROBOTIS_OpenCR_Virtual_ComPort_in_FS_Mode_FFFFFFFEFFFF-if00  115200,8,N,1 ---
--- Quit: Ctrl+] | Menu: Ctrl+T | Help: Ctrl+T followed by Ctrl+H ---
CHECK_OK DISARMED; TILT_TORQUE_OFF
STATE DISARMED POS=3070 VEL=0 SAMPLE_AGE_MS=0
ACK ARM; ONE_JOG_READY
ACK STOP_REQUEST
EVENT STOPPED DISARMED
ACK ARM; ONE_JOG_READY
EVENT ARM_IDLE_TIMEOUT
EVENT STOPPED DISARMED
ACK ARM; ONE_JOG_READY
ACK JOG +
EVENT JOG_TIMEOUT
EVENT STOPPED DISARMED
STATE DISARMED POS=3074 VEL=0 SAMPLE_AGE_MS=0
ACK ARM; ONE_JOG_READY
ACK JOG -
EVENT JOG_TIMEOUT
EVENT STOPPED DISARMED
STATE DISARMED POS=3067 VEL=0 SAMPLE_AGE_MS=0
ACK NO_NEW_MOTION
ERR LINE
STATE DISARMED POS=3067 VEL=0 SAMPLE_AGE_MS=0

--- exit ---
